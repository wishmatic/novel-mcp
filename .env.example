# Base

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Core

# Required: the bearer token every /mcp request must present.
API_KEY=change-me

# The format generated images are stored in when a call names none.
OUTPUT_FORMAT=webp

# Networking

# Maps URLs this server cannot reach to ones it can, as comma-separated public=private pairs. The
# private side is an absolute http(s) base URL or a directory to read images from, as in
# https://example.com=http://example:5080 or https://chat.example.com/images/=/data/librechat-data.
IMAGE_URL_MAP=

# Providers

# Enables the novelai tool. Without it, no tools are registered at all.
NOVELAI_API_KEY=

# File hosting

# Required: the public origin image URLs are built from. Put a reverse proxy or CDN in front of it
# if you want caching; stored images are immutable.
PUBLIC_HOST=

# Where generated images are written. Required to be non-empty.
FILES_DIR=files
